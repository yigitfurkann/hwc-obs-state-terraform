# 1) Bu dosyayı secrets.ps1 olarak kopyalayın:  Copy-Item secrets.ps1.example secrets.ps1
# 2) AK/SK değerlerini credentials.csv'den yapıştırın.
# 3) secrets.ps1 .gitignore'da; Git'e gitmez. Yine de işiniz bitince silebilirsiniz.

$env:HW_ACCESS_KEY  = "AK_DEGERINIZ"
$env:HW_SECRET_KEY  = "SK_DEGERINIZ"
$env:HW_REGION_NAME = "tr-west-1"

# State bucket adı (Huawei Cloud genelinde benzersiz olmalı)
$env:TF_STATE_BUCKET = "sirket-tf-state"
